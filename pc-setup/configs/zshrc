# ---- oh-my-zsh ----
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh
# syntax-highlighting: theme "green" is grey, so use real colors
ZSH_HIGHLIGHT_STYLES[command]="fg=#1ABB9B"
ZSH_HIGHLIGHT_STYLES[builtin]="fg=#1ABB9B"
ZSH_HIGHLIGHT_STYLES[alias]="fg=#1ABB9B"
ZSH_HIGHLIGHT_STYLES[function]="fg=#1ABB9B"
ZSH_HIGHLIGHT_STYLES[precommand]="fg=#1ABB9B,underline"
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]="fg=#E5C07B"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]="fg=#E5C07B"

# ---- PATH ----
export PATH="$HOME/.local/bin:$PATH"
[ -d /usr/local/go/bin ] && export PATH="$PATH:/usr/local/go/bin"

# node (nvm / volta)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
export VOLTA_HOME="$HOME/.volta"
[ -d "$VOLTA_HOME/bin" ] && export PATH="$VOLTA_HOME/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# local postgres build / static ffmpeg (only if present)
PG="$HOME/local/postgres/postgresql-16.3"
[ -d "$PG" ] && export PATH="$PG/src/bin/psql:$PATH" LD_LIBRARY_PATH="$PG/src/interfaces/libpq:$LD_LIBRARY_PATH"
[ -d "$HOME/ffmpeg/ffmpeg-7.0.2-amd64-static" ] && export PATH="$HOME/ffmpeg/ffmpeg-7.0.2-amd64-static:$PATH"

# homebrew
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# herdr completions
command -v herdr >/dev/null && eval "$(herdr completion zsh 2>/dev/null)"

# ---- aliases ----
alias slack='env XDG_SESSION_TYPE=x11 slack'
